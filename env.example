# ---- Copy to .env (local) or add in your host's dashboard (Vercel → Settings → Environment Variables).
# ---- These are SERVER-SIDE only. Never put them in the front-end files.

# Public URL of the live site (used for payment return URLs)
SITE_URL=https://www.hypenook.shop

# Where new orders are sent (Google Apps Script web app / Zapier / Make / your API).
# Without this, Cash on Delivery customers are asked to send their order on WhatsApp.
ORDER_WEBHOOK_URL=
# Shared secret sent as the X-HypeNook-Secret header; check it in your receiver.
ORDER_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- Reviews (Supabase). Create the table with supabase/reviews.sql first.
# Project URL: Supabase → Project Settings → API (or Data API).
SUPABASE_URL=https://dhitprdytgwvxgjrgmsc.supabase.co
# The SECRET key (service_role, or a new "sb_secret_..." key). Server only, NEVER in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Password for /admin.html (approve / delete reviews). Use a long, random one.
ADMIN_PASSWORD=

# ---- Online payments (leave empty until your merchant account is approved)
# One of: safepay | payfast | jazzcash | easypaisa  (adapter must be implemented in lib/payments.js)
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_MERCHANT_ID=
PAYMENT_SECURED_KEY=
PAYMENT_PASSWORD=
PAYMENT_INTEGRITY_SALT=
PAYMENT_STORE_ID=
PAYMENT_HASH_KEY=
PAYMENT_WEBHOOK_SECRET=
